// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(uuid())
  name_en   String
  name_ar   String
  slug      String    @unique
  icon      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String    @id @default(uuid())
  title_en       String
  title_ar       String
  desc_en        String
  desc_ar        String
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  brand          String?
  origin         String?
  images         String[]
  specifications Json?
  rfqItems       RFQ_Item[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum RFQStatus {
  Pending
  Reviewing
  Priced
  Completed
}

model RFQ {
  id                String     @id @default(uuid())
  client_name       String
  company_name      String?
  email             String
  phone             String
  status            RFQStatus  @default(Pending)
  attached_file_url String?
  items             RFQ_Item[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model RFQ_Item {
  id        String   @id @default(uuid())
  rfqId     String
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
