// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(uuid())
  name_en   String
  name_ar   String
  slug      String    @unique
  icon      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String    @id @default(uuid())
  title_en       String
  title_ar       String
  desc_en        String
  desc_ar        String
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  brand          String?
  origin         String?
  mpn            String?
  images         String[]
  isActive       Boolean   @default(true)
  specifications Json?
  rfqItems       RFQ_Item[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Service {
  id        String   @id @default(uuid())
  titleEn   String
  titleAr   String
  descEn    String
  descAr    String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id         String   @id @default(uuid())
  nameEn     String
  nameAr     String
  locationEn String
  locationAr String
  metricsEn  String?
  metricsAr  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model HeroContent {
  id         String   @id @default(uuid())
  titleEn    String
  titleAr    String
  subEn      String
  subAr      String
  bgImageUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum RFQStatus {
  Pending
  Reviewing
  Priced
  Completed
}

model RFQ {
  id                String     @id @default(uuid())
  client_name       String
  company_name      String?
  commercial_registration String?
  email             String
  phone             String
  status            RFQStatus  @default(Pending)
  attached_file_url String?
  items             RFQ_Item[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model RFQ_Item {
  id        String   @id @default(uuid())
  rfqId     String
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id             String   @id @default(uuid())
  statsProducts  String   @default("50k+")
  statsBrands    String   @default("200+")
  statsCountries String   @default("15+")
  statsSupport   String   @default("24/7")
  addressEn      String   @default("Cairo, Egypt")
  addressAr      String   @default("القاهرة، مصر")
  phone          String   @default("+20 123 456 7890")
  email          String   @default("info@suppliesx.com")
  taxId          String   @default("123-456-789")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
